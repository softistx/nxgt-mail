{
	"name": "@nxgt/mail-build",
	"version": "0.0.0",
	"private": true,
	"description": "The build side of @nxgt/mail: compiles ICU message catalogues and Maizzle templates into typed render functions that import nothing. A devDependency; never shipped to a server.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"nxgt-mail": "./dist/cli.js"
	},
	"keywords": [
		"email",
		"transactional",
		"icu",
		"i18n",
		"codegen",
		"typescript",
		"maizzle",
		"tailwindcss"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-mail.git",
		"directory": "packages/mail-build"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/cli.ts"
		]
	},
	"dependencies": {
		"@formatjs/icu-messageformat-parser": "^3.5.20",
		"@maizzle/framework": "6.1.7",
		"@vue/compiler-sfc": "^3.5.43",
		"jiti": "^2.7.0",
		"tailwind-merge": "^3",
		"vue": "^3.5.43"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2"
	},
	"peerDependencies": {
		"typescript": "^6.0.3"
	}
}
