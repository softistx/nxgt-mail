{
	"name": "@nxgt/mail-config",
	"version": "0.0.0",
	"private": true,
	"description": "A shareable Maizzle config: defineMailConfig layers plugins under the project's own config, with every build event chained instead of overwritten.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"email",
		"maizzle",
		"config",
		"plugins",
		"tailwindcss"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-mail.git",
		"directory": "packages/mail-config"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"defu": "^6.1.4"
	},
	"devDependencies": {
		"@maizzle/framework": "6.1.7",
		"@maizzle/tailwindcss": "1.5.6",
		"@types/bun": "^1.4.2"
	},
	"peerDependencies": {
		"@maizzle/framework": "^6.1.7",
		"@maizzle/tailwindcss": "^1.5.6",
		"typescript": "^6.0.3"
	}
}
