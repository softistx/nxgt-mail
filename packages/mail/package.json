{
	"name": "@nxgt/mail",
	"version": "1.0.1",
	"description": "The run-time side of transactional e-mail: the renderer that fills a Maizzle build made with @nxgt/mail-i18n, the Mailer a transport implements, its errors, a memory transport and locale selection. No dependency.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./renderer": {
			"types": "./dist/renderer.d.ts",
			"import": "./dist/renderer.js",
			"default": "./dist/renderer.js"
		},
		"./conformance": {
			"types": "./dist/conformance/index.d.ts",
			"import": "./dist/conformance/index.js",
			"default": "./dist/conformance/index.js"
		},
		"./telemetry": {
			"types": "./dist/telemetry.d.ts",
			"import": "./dist/telemetry.js",
			"default": "./dist/telemetry.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"email",
		"transactional",
		"mailer",
		"typescript",
		"i18n"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-mail.git",
		"directory": "packages/mail"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/renderer.ts",
			"src/conformance/index.ts",
			"src/telemetry.ts"
		],
		"noNodeBuiltins": [
			".",
			"./conformance",
			"./telemetry"
		]
	},
	"devDependencies": {
		"@opentelemetry/api": "1.9.1",
		"@opentelemetry/sdk-metrics": "^2.4.0",
		"@opentelemetry/sdk-trace-base": "^2.4.0",
		"@types/bun": "^1.4.2"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.9.0",
		"typescript": "^6.0.3"
	},
	"peerDependenciesMeta": {
		"@opentelemetry/api": {
			"optional": true
		}
	}
}
