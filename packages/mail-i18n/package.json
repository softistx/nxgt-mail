{
	"name": "@nxgt/mail-i18n",
	"version": "0.5.0",
	"description": "An i18n plugin for a Maizzle project: ICU catalogues checked at build time, t() in templates, one output per locale, and the manifest the renderer reads. createTranslator for use outside templates.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"email",
		"maizzle",
		"i18n",
		"icu",
		"messageformat",
		"vue"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-mail.git",
		"directory": "packages/mail-i18n"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit && bun run typecheck:templates",
		"typecheck:templates": "bun run prepare:templates && cd test/fixture && vue-tsc -p tsconfig.json",
		"prepare:templates": "cd test/fixture && maizzle prepare"
	},
	"dependencies": {
		"@formatjs/icu-messageformat-parser": "3.5.20",
		"@nxgt/i18n-vue": "^0.1.1"
	},
	"devDependencies": {
		"@maizzle/framework": "6.1.7",
		"@maizzle/tailwindcss": "1.5.6",
		"@nxgt/mail-config": "workspace:*",
		"@types/bun": "^1.4.2",
		"vue": "3.5.43",
		"vue-tsc": "^3.3.11"
	},
	"peerDependencies": {
		"@maizzle/framework": "^6.1.7",
		"@nxgt/mail-config": "workspace:^",
		"typescript": "^6.0.3",
		"vue": "^3.5.0"
	},
	"peerDependenciesMeta": {
		"vue": {
			"optional": true
		}
	}
}
