{
	"name": "@nxgt/mail-preset",
	"version": "0.0.0",
	"private": true,
	"description": "The default preset for @nxgt/mail-build: neutral theme tokens for e-mail clients, a transactional layout, components and the shared messages in English and French. Build time only.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"email",
		"transactional",
		"maizzle",
		"tailwindcss",
		"preset",
		"i18n"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-mail.git",
		"directory": "packages/mail-preset"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@nxgt/mail-build": "workspace:^",
		"@types/bun": "^1.4.2"
	},
	"peerDependencies": {
		"@nxgt/mail-build": "workspace:^"
	}
}
